# Scarci Digital - Environment Configuration
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# ---- Admin dashboard (/admin) ----
# Password for the admin dashboard. Use a long, unique password.
ADMIN_PASSWORD=
# Random string used to sign login sessions (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# ---- Storage (required on Vercel for the dashboard and lead inbox) ----
# Add "Upstash for Redis" from Vercel → Storage; it sets these automatically.
# Locally, leave empty to use .data/store.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Lead email alerts (optional) ----
# Sends an email for every new lead via https://resend.com
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
# Must be on a domain verified in Resend, e.g. "Scarci Digital <leads@scarcidigital.com>"
LEAD_FROM_EMAIL=

# ---- Booking link (optional) ----
# Cal.com or Calendly URL. When set, every "Book a Free Call" button opens it.
NEXT_PUBLIC_BOOKING_URL=

# ---- AI chat assistant (optional) ----
# Without a key, the assistant uses built-in answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
